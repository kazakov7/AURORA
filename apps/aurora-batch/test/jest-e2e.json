{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/../../aurora-api/test/global-setup.cjs",
  "globalTeardown": "<rootDir>/../../aurora-api/test/global-teardown.cjs",
  "setupFiles": ["<rootDir>/../../aurora-api/test/setup-env.cjs"],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/../../aurora-api/tsconfig.spec.json", "diagnostics": false }
    ]
  }
}
