{
	"name": "aurora",
	"version": "0.1.0",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"{apps,libs}/**/*.ts\"",
		"format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"dev:batch": "nest start aurora-batch --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/apps/aurora-api/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./apps/aurora-api/test/jest-e2e.json"
	},
	"dependencies": {
		"@as-integrations/express5": "^1.1.2",
		"@nestjs/apollo": "^13.4.5",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/graphql": "^13.4.5",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mongoose": "^11.0.3",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^11.2.7",
		"@nestjs/websockets": "^11.2.7",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cloudinary": "^2.11.0",
		"google-auth-library": "^10.9.1",
		"graphql-upload": "^15.0.2",
		"jose": "^5.10.0",
		"moment": "^2.31.0",
		"mongoose": "^8.24.5",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.4",
		"stripe": "^23.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.0.0",
		"jest": "^29.7.0",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.10",
		"socket.io-client": "^4.8.4",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.14",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": "<rootDir>/apps/aurora-api/tsconfig.spec.json",
					"diagnostics": false
				}
			]
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/apps/"
		]
	},
	"overrides": {
		"lodash": "^4.18.1",
		"multer": "^2.4.0",
		"graphql-upload": {
			"@types/express": "$@types/express"
		}
	}
}
